# Local (non-Docker) development settings. Copy to backend/.env. All keys use the SS_ prefix.
SS_ENVIRONMENT=development
SS_FRONTEND_URL=http://localhost:5180
SS_CORS_ORIGINS=http://localhost:5180

# Defaults to SQLite in backend/var/. For PostgreSQL:
# SS_DATABASE_URL=postgresql+psycopg://securesphere:password@localhost:5432/securesphere

# Required (>= 32 random chars) outside development:
# SS_SECRET_KEY=

# Optional tuning
# SS_SESSION_IDLE_MINUTES=30
# SS_SESSION_ABSOLUTE_HOURS=12
# SS_LOGIN_MAX_FAILURES=5
# SS_LOCKOUT_MINUTES=15
# SS_AUDIT_RETENTION_DAYS=180
# SS_MAIL_BACKEND=outbox        # dev only: writes emails to backend/var/dev_mail/
