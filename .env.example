# Copy to .env and replace every value. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_USER=securesphere
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=securesphere

# HMAC key for session/reset token hashing and CSRF derivation (>= 32 random characters).
SS_SECRET_KEY=replace-with-a-long-random-secret

# Public URL of the app (used in password-reset links and the CORS allowlist).
SS_FRONTEND_URL=http://localhost:8080
